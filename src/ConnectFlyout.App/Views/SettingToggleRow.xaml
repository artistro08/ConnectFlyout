<UserControl
    x:Class="ConnectFlyout.App.Views.SettingToggleRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Setting Row: name and subtitle on the left, the switch flush right -->
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource SettingSubtitleStyle}" Text="{x:Bind Subtitle, Mode=OneWay}" />
        </StackPanel>
        <ToggleSwitch
            Grid.Column="1"
            VerticalAlignment="Center"
            AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
            IsOn="{x:Bind IsOn, Mode=TwoWay}"
            Style="{StaticResource CardToggleSwitchStyle}" />
    </Grid>
</UserControl>
