<UserControl
    x:Class="ConnectFlyout.App.Views.TrayTooltip"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:ConnectFlyout.App"
    xmlns:local="using:ConnectFlyout.App.Views"
    xmlns:vm="using:ConnectFlyout.Presentation.ViewModels">

    <!-- Open and close fades, on Fluent's fast (167 ms) and faster (83 ms) timings -->
    <UserControl.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation
                Storyboard.TargetName="Root"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.167" />
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation
                Storyboard.TargetName="Root"
                Storyboard.TargetProperty="Opacity"
                To="0"
                Duration="0:0:0.083" />
        </Storyboard>
    </UserControl.Resources>

    <!-- Tray Tooltip: a Windows 11 tooltip (acrylic, stroke, shadow) holding each connected
         headset's name over its battery row. The outer padding is room for the shadow. -->
    <Grid x:Name="Root" Padding="{x:Bind ShadowMargin}">

        <!-- Panel -->
        <Grid
            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            Translation="0,0,16">
            <Grid.Shadow>
                <ThemeShadow />
            </Grid.Shadow>

            <!-- Acrylic Background (kept lit: this window never gets focus) -->
            <SystemBackdropElement CornerRadius="{ThemeResource OverlayCornerRadius}">
                <SystemBackdropElement.SystemBackdrop>
                    <app:ActiveAcrylicBackdrop />
                </SystemBackdropElement.SystemBackdrop>
            </SystemBackdropElement>

            <!-- Content, with a tooltip's padding -->
            <Grid Padding="{ThemeResource ToolTipBorderPadding}">

                <!-- Headsets -->
                <ItemsRepeater x:Name="HeadsetList">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="10" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:HeadsetViewModel">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DeviceName}" />
                                <local:BatteryRow Headset="{x:Bind}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- Nothing Connected -->
                <TextBlock x:Name="EmptyText" Text="No headphones connected" />
            </Grid>
        </Grid>
        <!-- /Panel -->
    </Grid>
</UserControl>
