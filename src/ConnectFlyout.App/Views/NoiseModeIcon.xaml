<UserControl
    x:Class="ConnectFlyout.App.Views.NoiseModeIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="20"
    Height="20"
    AutomationProperties.AccessibilityView="Raw">

    <!-- Noise Mode Icon: a PathIcon, so it takes the surrounding text color and follows light,
         dark and the selected tile's colors like any other Fluent icon. Shape set in code. -->
    <Viewbox>
        <PathIcon x:Name="Icon" Width="24" Height="24" />
    </Viewbox>
</UserControl>
