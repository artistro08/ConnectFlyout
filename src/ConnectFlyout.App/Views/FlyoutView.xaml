<UserControl
    x:Class="ConnectFlyout.App.Views.FlyoutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:ConnectFlyout.App"
    xmlns:headsets="using:ConnectFlyout.Presentation.Headsets"
    xmlns:local="using:ConnectFlyout.App.Views"
    xmlns:vm="using:ConnectFlyout.Presentation.ViewModels"
    IsTabStop="True"
    KeyboardAcceleratorPlacementMode="Hidden"
    UseSystemFocusVisuals="False">

    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
    </UserControl.KeyboardAccelerators>

    <Grid x:Name="ContentRoot" RowDefinitions="*,Auto">

        <!-- Empty Page -->
        <StackPanel
            Grid.Row="0"
            Padding="24"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsEmptyVisible, Mode=OneWay}">
            <FontIcon
                HorizontalAlignment="Center"
                FontSize="48"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE7F6;" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="No Sony headphones connected" />
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SecondaryTextStyle}"
                Text="Connect them in Bluetooth settings and they'll show up here."
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <HyperlinkButton
                HorizontalAlignment="Center"
                Content="Open Bluetooth settings"
                NavigateUri="ms-settings:bluetooth" />
        </StackPanel>
        <!-- /Empty Page -->

        <!-- Picker Page: rows inset 8 px from the flyout's edges on every side (6 px padding
             plus each row's 2 px margin), so a highlighted row sits evenly in the corners -->
        <Grid
            Grid.Row="0"
            Padding="8,6"
            Visibility="{x:Bind ViewModel.IsPickerVisible, Mode=OneWay}">
            <ListView
                x:Name="HeadsetList"
                IsItemClickEnabled="True"
                ItemClick="OnHeadsetClick"
                ItemsSource="{x:Bind ViewModel.Headsets}"
                SelectionMode="None">
                <!-- Item transitions are set in code: off while a default headset is set -->

                <!-- The row draws its own hover and press backgrounds (they fade, see
                     PickerRowStyle), so the list's instant ones are turned off -->
                <ListView.Resources>
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,2" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HeadsetViewModel">
                        <Grid
                            AutomationProperties.Name="{x:Bind DeviceName}"
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="12"
                            PointerCanceled="OnPickerRowRest"
                            PointerEntered="OnPickerRowHover"
                            PointerExited="OnPickerRowRest"
                            PointerPressed="OnPickerRowPressed"
                            PointerReleased="OnPickerRowHover"
                            Style="{StaticResource PickerRowStyle}">
                            <!-- Same fade as a button's hover -->
                            <Grid.BackgroundTransition>
                                <BrushTransition Duration="0:0:0.083" />
                            </Grid.BackgroundTransition>
                            <Grid.Resources>
                                <SolidColorBrush x:Key="RowHoverBrush" Color="{ThemeResource SubtleFillColorSecondary}" />
                                <SolidColorBrush x:Key="RowPressedBrush" Color="{ThemeResource SubtleFillColorTertiary}" />
                                <SolidColorBrush x:Key="RowRestBrush" Color="Transparent" />
                            </Grid.Resources>
                            <!-- Model picture, or the headphone icon when there's no picture -->
                            <local:DevicePicture ModelName="{x:Bind ModelName}" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind DeviceName}" />
                                <!-- Status, or a failed connect in the caution color (the list has no warning bar) -->
                                <TextBlock Style="{x:Bind app:TileStyles.PickStatus(HasError), Mode=OneWay}" Text="{x:Bind PickerStatusText, Mode=OneWay}" />
                                <local:BatteryRow Headset="{x:Bind}" Visibility="{x:Bind IsConnected, Mode=OneWay}" />
                            </StackPanel>

                            <!-- Connect, for headphones Windows isn't connected to (the row itself opens the page) -->
                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Connect over Bluetooth"
                                Command="{x:Bind ConnectCommand}"
                                ToolTipService.ToolTip="Connects over Bluetooth. Another device using them may lose the audio."
                                Visibility="{x:Bind ShowConnect, Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE702;" />
                                    <TextBlock Text="Connect" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <!-- /Picker Page -->

        <!-- Device Page -->
        <ScrollViewer
            Grid.Row="0"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            Visibility="{x:Bind ViewModel.IsDeviceVisible, Mode=OneWay}">
            <StackPanel x:Name="DevicePanel" Padding="20" Spacing="12">

                <!-- Header: picture, name, battery row and audio line, centered like Sony's app -->
                <Grid>
                    <StackPanel HorizontalAlignment="Center" Spacing="6">
                        <!-- Picture, with breathing room above and below -->
                        <Image
                            Height="120"
                            Margin="0,8,0,8"
                            HorizontalAlignment="Center"
                            AutomationProperties.AccessibilityView="Raw"
                            Source="{x:Bind app:DeviceArt.For(ViewModel.CurrentHeadset.ModelName), Mode=OneWay}"
                            Stretch="Uniform"
                            Visibility="{x:Bind app:DeviceArt.VisibleFor(ViewModel.CurrentHeadset.ModelName), Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.CurrentHeadset.DeviceName, Mode=OneWay}" />
                        <!-- Battery -->
                        <local:BatteryRow HorizontalAlignment="Center" Headset="{x:Bind ViewModel.CurrentHeadset, Mode=OneWay}" />

                        <!-- Status Line: "Connecting…" / "App Disconnected" / "Disconnected" until connected, then the audio line -->
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind ViewModel.CurrentHeadset.StatusText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.CurrentHeadset.ShowStatus, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind ViewModel.CurrentHeadset.AudioText, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.CurrentHeadset.IsConnected, Mode=OneWay}" />

                        <!-- Reconnect: a plain link under "App Disconnected" (Windows has the headset, the app doesn't) -->
                        <HyperlinkButton
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Reconnect device"
                            Command="{x:Bind ViewModel.CurrentHeadset.ReconnectCommand, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.CurrentHeadset.ShowReconnect, Mode=OneWay, FallbackValue=Collapsed}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <local:PlugIcon VerticalAlignment="Center" IsConnected="True" />
                                <TextBlock Text="Reconnect device" />
                            </StackPanel>
                        </HyperlinkButton>

                        <!-- Connect: asks Windows to connect the headset over Bluetooth, while Windows isn't -->
                        <HyperlinkButton
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Connect over Bluetooth"
                            Command="{x:Bind ViewModel.CurrentHeadset.ConnectCommand, Mode=OneWay}"
                            ToolTipService.ToolTip="Connects over Bluetooth. Another device using them may lose the audio."
                            Visibility="{x:Bind ViewModel.CurrentHeadset.ShowConnect, Mode=OneWay, FallbackValue=Collapsed}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="16" Glyph="&#xE702;" />
                                <TextBlock Text="Connect" />
                            </StackPanel>
                        </HyperlinkButton>
                    </StackPanel>

                    <!-- Back and busy indicator sit in the corners; the negative margin pulls the
                         back arrow out of the page padding, close to the card's corner -->
                    <Button
                        Margin="-14,-14,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        AutomationProperties.Name="Back to headphones"
                        Command="{x:Bind ViewModel.BackCommand}"
                        Style="{StaticResource FooterIconButtonStyle}"
                        ToolTipService.ToolTip="Back"
                        Visibility="{x:Bind ViewModel.ShowBack, Mode=OneWay}">
                        <FontIcon FontSize="16" Glyph="&#xE72B;" />
                    </Button>
                    <!-- Pulled out of the page padding so it lines up with the back arrow's center -->
                    <ProgressRing
                        Width="20"
                        Height="20"
                        Margin="0,-6,-6,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        IsActive="{x:Bind ViewModel.CurrentHeadset.IsConnecting, Mode=OneWay}" />
                </Grid>
                <!-- /Header -->

                <!-- Error: a command that didn't go through (a warning, not an alarm). Collapsed
                     when closed too, or the panel still spaces around it. -->
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.CurrentHeadset.HasError, Mode=OneWay, FallbackValue=False}"
                    Message="{x:Bind ViewModel.CurrentHeadset.ErrorMessage, Mode=OneWay}"
                    Severity="Warning"
                    Visibility="{x:Bind ViewModel.CurrentHeadset.HasError, Mode=OneWay, FallbackValue=Collapsed}" />

                <MenuFlyoutSeparator />

                <!-- Noise Control (disabled while disconnected) -->
                <ContentControl IsEnabled="{x:Bind ViewModel.CurrentHeadset.IsConnected, Mode=OneWay, FallbackValue=False}" Style="{StaticResource SectionStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Noise control" />
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <local:NoiseModeTile
                                Command="{x:Bind ViewModel.CurrentHeadset.SetNoiseModeCommand, Mode=OneWay}"
                                IsSelected="{x:Bind ViewModel.CurrentHeadset.IsNoiseOff, Mode=OneWay, FallbackValue=False}"
                                Label="Off"
                                Mode="Off" />
                            <local:NoiseModeTile
                                Grid.Column="1"
                                Command="{x:Bind ViewModel.CurrentHeadset.SetNoiseModeCommand, Mode=OneWay}"
                                IsSelected="{x:Bind ViewModel.CurrentHeadset.IsNoiseCancelling, Mode=OneWay, FallbackValue=False}"
                                Label="ANC"
                                Mode="NoiseCancelling" />
                            <local:NoiseModeTile
                                Grid.Column="2"
                                Command="{x:Bind ViewModel.CurrentHeadset.SetNoiseModeCommand, Mode=OneWay}"
                                IsSelected="{x:Bind ViewModel.CurrentHeadset.IsAmbient, Mode=OneWay, FallbackValue=False}"
                                Label="Ambient"
                                Mode="Ambient" />
                        </Grid>

                        <!-- Ambient Level -->
                        <StackPanel Visibility="{x:Bind ViewModel.CurrentHeadset.IsAmbient, Mode=OneWay}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Ambient sound" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentHeadset.AmbientLevelText, Mode=OneWay}" />
                            </Grid>
                            <Slider
                                AutomationProperties.Name="Ambient sound level"
                                Maximum="20"
                                Minimum="1"
                                StepFrequency="1"
                                TickFrequency="1"
                                TickPlacement="Outside"
                                Value="{x:Bind ViewModel.CurrentHeadset.AmbientLevel, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- Focus On Voice: an ambient sound setting; in the other modes the headset
                             ignores it and keeps its last value, so the switch only shows in Ambient -->
                        <Grid ColumnDefinitions="*,Auto" Visibility="{x:Bind ViewModel.CurrentHeadset.IsAmbient, Mode=OneWay}">
                            <TextBlock VerticalAlignment="Center" Text="Focus on voice" />
                            <ToggleSwitch
                                Grid.Column="1"
                                AutomationProperties.Name="Focus on voice"
                                IsOn="{x:Bind ViewModel.CurrentHeadset.FocusOnVoice, Mode=TwoWay}"
                                Style="{StaticResource CardToggleSwitchStyle}" />
                        </Grid>

                        <!-- Scenes -->
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.CurrentHeadset.SceneItems, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <app:UniformColumnsLayout
                                    ColumnSpacing="8"
                                    Columns="3"
                                    RowSpacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:SceneItemViewModel">
                                    <Button
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="{x:Bind Name}"
                                        Click="OnSceneClick"
                                        Style="{x:Bind app:TileStyles.PickScene(IsActive), Mode=OneWay}"
                                        Tag="{x:Bind Scene}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon FontSize="14" Glyph="{x:Bind Glyph}" />
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </ContentControl>
                <!-- /Noise Control -->

                <!-- Playback: which connected device (multipoint) has the audio. Only with two or
                     more to choose from, on headphones that can switch. -->
                <MenuFlyoutSeparator Visibility="{x:Bind ViewModel.CurrentHeadset.ShowPlayback, Mode=OneWay, FallbackValue=Collapsed}" />
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.CurrentHeadset.ShowPlayback, Mode=OneWay, FallbackValue=Collapsed}">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Playback" />
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.CurrentHeadset.PlaybackDevices, Mode=OneWay}">
                        <ItemsRepeater.Layout>
                            <app:UniformColumnsLayout
                                ColumnSpacing="8"
                                Columns="2"
                                RowSpacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="headsets:PlaybackDevice">
                                <Button
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="{x:Bind Name}"
                                    Click="OnPlaybackClick"
                                    Style="{x:Bind app:TileStyles.PickScene(Playing)}"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="{x:Bind Name}">
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
                <!-- /Playback -->

                <MenuFlyoutSeparator />

                <!-- Codec-gated popup Sound -->
                <ContentControl
                    IsEnabled="{x:Bind ViewModel.CurrentHeadset.CanEditHeadsetSound, Mode=OneWay, FallbackValue=False}"
                    Style="{StaticResource SectionStyle}"
                    Visibility="{x:Bind ViewModel.CurrentHeadset.ShowPopupSoundSection, Mode=OneWay, FallbackValue=Collapsed}">
                    <StackPanel Spacing="8">
                        <Grid
                            ColumnDefinitions="*,Auto"
                            Visibility="{x:Bind ViewModel.CurrentHeadset.ShowPopupEqualizer, Mode=OneWay, FallbackValue=Collapsed}">
                            <TextBlock VerticalAlignment="Center" Text="Equalizer" />
                            <ComboBox
                                Grid.Column="1"
                                MinWidth="150"
                                AutomationProperties.Name="Equalizer preset"
                                DisplayMemberPath="Name"
                                ItemsSource="{x:Bind ViewModel.CurrentHeadset.EqualizerPresets, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.CurrentHeadset.SelectedEqualizerIndex, Mode=TwoWay}" />
                        </Grid>
                        <Grid
                            ColumnDefinitions="*,Auto"
                            Visibility="{x:Bind ViewModel.CurrentHeadset.ShowPopupDsee, Mode=OneWay, FallbackValue=Collapsed}">
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Bind ViewModel.CurrentHeadset.DseeName, Mode=OneWay}" />
                            <ComboBox
                                Grid.Column="1"
                                MinWidth="150"
                                AutomationProperties.Name="{x:Bind ViewModel.CurrentHeadset.DseeName, Mode=OneWay}"
                                ItemsSource="{x:Bind vm:HeadsetViewModel.DseeOptions}"
                                SelectedIndex="{x:Bind ViewModel.CurrentHeadset.DseeIndex, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </ContentControl>
                <!-- /Codec-gated popup Sound -->
                <!-- Connection Mode -->
                <MenuFlyoutSeparator
                    Visibility="{x:Bind ViewModel.CurrentHeadset.ShowPopupConnectionSeparator, Mode=OneWay}" />
                <ContentControl
                    IsEnabled="{x:Bind ViewModel.CurrentHeadset.CanChangeConnectionMode, Mode=OneWay, FallbackValue=False}"
                    Style="{StaticResource SectionStyle}"
                    Visibility="{x:Bind ViewModel.CurrentHeadset.HasConnectionQualityControl, Mode=OneWay}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock VerticalAlignment="Center" Text="Connection mode" />
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="150"
                            AutomationProperties.Name="Connection mode"
                            ItemsSource="{x:Bind vm:HeadsetViewModel.ConnectionQualityOptions}"
                            SelectedIndex="{x:Bind ViewModel.CurrentHeadset.ConnectionQualityIndex, Mode=TwoWay}" />
                    </Grid>
                </ContentControl>

            </StackPanel>
        </ScrollViewer>
        <!-- /Device Page -->

        <!-- Footer -->
        <Grid
            Grid.Row="1"
            Height="52"
            Padding="12,0"
            Background="{ThemeResource FlyoutFooterBackgroundBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            ColumnDefinitions="*,Auto">
            <!-- Turn Off: far left, only while connected to the shown headset -->
            <Button
                Height="36"
                Padding="10,0"
                VerticalAlignment="Center"
                Command="{x:Bind ViewModel.CurrentHeadset.PowerOffCommand, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.CurrentHeadset.CanPowerOffFromPopup, Mode=OneWay, FallbackValue=False}"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Turn off the headphones"
                Visibility="{x:Bind ViewModel.CurrentHeadset.CanPowerOffFromPopup, Mode=OneWay, FallbackValue=Collapsed}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE7E8;" />
                    <TextBlock VerticalAlignment="Center" Text="Turn off" />
                </StackPanel>
            </Button>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="4">
                <!-- Refresh: reopens the link while connected -->
                <Button
                    Style="{StaticResource FooterIconButtonStyle}"
                    AutomationProperties.Name="Refresh"
                    Command="{x:Bind ViewModel.ReconnectCommand}"
                    ToolTipService.ToolTip="Refresh"
                    Visibility="{x:Bind ViewModel.CurrentHeadset.IsConnected, Mode=OneWay, FallbackValue=Collapsed}">
                    <FontIcon FontSize="16" Glyph="&#xE72C;" />
                </Button>

                <!-- Disconnect: lets another device (like the phone app) take over -->
                <Button
                    Style="{StaticResource FooterIconButtonStyle}"
                    AutomationProperties.Name="Disconnect"
                    Command="{x:Bind ViewModel.CurrentHeadset.DisconnectCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="Disconnect control"
                    Visibility="{x:Bind ViewModel.CurrentHeadset.IsConnected, Mode=OneWay, FallbackValue=Collapsed}">
                    <local:PlugIcon Size="20" />
                </Button>

                <!-- Reconnect: takes Disconnect's place while disconnected -->
                <Button
                    Style="{StaticResource FooterIconButtonStyle}"
                    AutomationProperties.Name="Reconnect"
                    Command="{x:Bind ViewModel.CurrentHeadset.ReconnectCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="Reconnect"
                    Visibility="{x:Bind ViewModel.CurrentHeadset.ShowReconnect, Mode=OneWay, FallbackValue=Collapsed}">
                    <local:PlugIcon IsConnected="True" Size="20" />
                </Button>

                <Button
                    Style="{StaticResource FooterIconButtonStyle}"
                    AutomationProperties.Name="Settings"
                    Command="{x:Bind ViewModel.OpenSettingsCommand}"
                    ToolTipService.ToolTip="Settings">
                    <FontIcon FontSize="16" Glyph="&#xE713;" />
                </Button>
            </StackPanel>
        </Grid>
        <!-- /Footer -->
    </Grid>
</UserControl>
