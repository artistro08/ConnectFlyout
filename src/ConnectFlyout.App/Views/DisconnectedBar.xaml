<UserControl
    x:Class="ConnectFlyout.App.Views.DisconnectedBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConnectFlyout.App.Views">

    <!-- Disconnected Warning: text on the left, Reconnect on the right. The text goes in the
         content (not Message) so the bar lays it out as one full-width row. Where it's used,
         collapse the whole control while hidden, or the panel around it still spaces for it. -->
    <InfoBar
        IsClosable="False"
        IsOpen="{x:Bind Headset.ShowDisconnectedWarning, Mode=OneWay, FallbackValue=False}"
        Severity="Warning">
        <Grid
            Margin="0,8,8,8"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="12">
            <TextBlock
                VerticalAlignment="Center"
                Text="{x:Bind Headset.DisconnectedMessage, Mode=OneWay}"
                TextWrapping="Wrap" />
            <Button
                Grid.Column="1"
                AutomationProperties.Name="Reconnect"
                Command="{x:Bind Headset.ReconnectCommand, Mode=OneWay}"
                Visibility="{x:Bind Headset.ShowReconnect, Mode=OneWay, FallbackValue=Collapsed}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <local:PlugIcon VerticalAlignment="Center" IsConnected="True" />
                    <TextBlock Text="Reconnect" />
                </StackPanel>
            </Button>
        </Grid>
    </InfoBar>
</UserControl>
