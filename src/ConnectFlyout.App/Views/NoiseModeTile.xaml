<UserControl
    x:Class="ConnectFlyout.App.Views.NoiseModeTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:ConnectFlyout.App"
    xmlns:local="using:ConnectFlyout.App.Views">

    <!-- Noise Mode Tile: built like a Windows Quick Settings tile, an icon-only toggle button
         (accent while checked, its icon following) with its label underneath -->
    <StackPanel Spacing="8">
        <ToggleButton
            x:Name="TileButton"
            AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
            Click="OnClick"
            Command="{x:Bind Command, Mode=OneWay}"
            CommandParameter="{x:Bind app:TileStyles.ModeName(Mode), Mode=OneWay}"
            IsChecked="{x:Bind IsSelected, Mode=OneWay}"
            Style="{StaticResource TileButtonStyle}">
            <!-- 20 px box: the drawing leaves a margin, so the visible icon is Quick Settings' 16 px -->
            <local:NoiseModeIcon Mode="{x:Bind Mode, Mode=OneWay}" />
        </ToggleButton>
        <!-- Caption size (12), as under Quick Settings' tiles -->
        <TextBlock
            HorizontalAlignment="Center"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind Label, Mode=OneWay}"
            TextTrimming="CharacterEllipsis" />
    </StackPanel>
</UserControl>
