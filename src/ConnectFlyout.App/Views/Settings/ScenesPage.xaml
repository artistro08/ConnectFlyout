<local:SettingsPageBase
    x:Class="ConnectFlyout.App.Views.Settings.ScenesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConnectFlyout.App.Views.Settings"
    xmlns:views="using:ConnectFlyout.App.Views"
    xmlns:vm="using:ConnectFlyout.Presentation.ViewModels">

    <!-- The page scrolls under a footer that stays put; the bottom margin lets the last card
         scroll clear of it -->
    <Grid>
        <ContentControl Style="{StaticResource SettingsPageStyle}">
            <StackPanel Margin="0,0,0,57" Spacing="8">
                <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="Scenes" />
                <TextBlock
                    Margin="0,0,0,8"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="Scenes are the buttons below Noise control in the flyout. Each scene applies a noise control setting. The app saves a change when you make it." />

                <!-- Scene Cards: icon, name and a summary in the header; the settings and Delete inside -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Scenes}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:SceneEditorViewModel">
                            <views:SettingsExpander Style="{StaticResource SettingsExpanderStyle}">
                                <views:SettingsExpander.Header>
                                    <Grid
                                        Margin="0,16"
                                        ColumnDefinitions="Auto,*,Auto"
                                        ColumnSpacing="20">
                                        <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" Style="{StaticResource SettingsCardIconStyle}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                                            <TextBlock Style="{StaticResource SettingSubtitleStyle}" Text="{x:Bind Summary, Mode=OneWay}" />
                                        </StackPanel>

                                        <!-- On/Off: on while the connected headphones are in this scene. Turning it
                                             on applies the scene; off turns noise control off. -->
                                        <ToggleSwitch
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="Scene on"
                                            IsOn="{x:Bind IsActive, Mode=OneWay}"
                                            Style="{StaticResource CardToggleSwitchStyle}"
                                            Tag="{x:Bind}"
                                            Toggled="OnSceneToggled"
                                            ToolTipService.ToolTip="Turn the scene on or off" />
                                    </Grid>
                                </views:SettingsExpander.Header>
                                <StackPanel>
                                    <local:SceneEditor Scene="{x:Bind}" />

                                    <!-- Shortcut: the same picker as Settings > Shortcuts -->
                                    <Border Style="{StaticResource SettingsExpanderDividerStyle}" />
                                    <local:SceneShortcutRow SceneId="{x:Bind Id}" />

                                    <!-- Delete: only here, inside the open card -->
                                    <Border Style="{StaticResource SettingsExpanderDividerStyle}" />
                                    <Border Style="{StaticResource SettingsExpanderItemStyle}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Delete scene" />
                                                <TextBlock Style="{StaticResource SettingSubtitleStyle}" Text="Removes the scene from the flyout and from this page." />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Delete scene"
                                                Click="OnDeleteSceneClick"
                                                Tag="{x:Bind}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                    <TextBlock Text="Delete" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </views:SettingsExpander>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <!-- /Scene Cards -->

                <!-- Reorder -->
                <Border Style="{StaticResource SettingsCardStyle}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
                        <FontIcon Glyph="&#xE8CB;" Style="{StaticResource SettingsCardIconStyle}" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="Reorder scenes" />
                        <Button
                            Grid.Column="2"
                            Click="OnReorderClick"
                            Content="Reorder" />
                    </Grid>
                </Border>
            </StackPanel>
        </ContentControl>

        <!-- Footer -->
        <Border Style="{StaticResource SettingsFooterStyle}">
            <Grid MaxWidth="900">
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button Command="{x:Bind ViewModel.ResetScenesCommand}" Content="Reset to defaults" />
                    <Button
                        Click="OnAddSceneClick"
                        Content="Add scene"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
        <!-- /Footer -->
    </Grid>
</local:SettingsPageBase>
