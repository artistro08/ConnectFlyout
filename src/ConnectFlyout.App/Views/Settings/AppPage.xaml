<local:SettingsPageBase
    x:Class="ConnectFlyout.App.Views.Settings.AppPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConnectFlyout.App.Views.Settings"
    xmlns:views="using:ConnectFlyout.App.Views"
    xmlns:vm="using:ConnectFlyout.Presentation.ViewModels">

    <ContentControl Style="{StaticResource SettingsPageStyle}">
        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="General" />

            <!-- Launch At Sign-In -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Start when you sign in" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="If you cannot turn this on, check Settings &gt; Apps &gt; Startup." />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        AutomationProperties.Name="Start when you sign in"
                        IsOn="{x:Bind ViewModel.LaunchAtSignIn, Mode=TwoWay}"
                        Style="{StaticResource CardToggleSwitchStyle}" />
                </Grid>
            </Border>

            <!-- Tray Icon: the main switch in the header, "until my headphones connect" inside -->
            <Expander Style="{StaticResource SettingsExpanderStyle}">
                <Expander.Header>
                    <views:SettingToggleRow
                        Margin="0,16"
                        IsOn="{x:Bind ViewModel.HideTray, Mode=TwoWay}"
                        Subtitle="ConnectFlyout continues to run in the background. Select what the Start menu opens."
                        Title="Hide the tray icon" />
                </Expander.Header>
                <StackPanel Spacing="16">
                    <!-- Hide Until Connected -->
                    <views:SettingToggleRow
                        IsEnabled="{x:Bind ViewModel.CanHideTrayWhileDisconnected, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.HideTrayWhileDisconnected, Mode=TwoWay}"
                        Subtitle="Shows the icon while the headphones are connected."
                        Title="Hide the tray icon until the headphones connect" />

                    <!-- Hidden Tray Launch -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="When you open ConnectFlyout while the icon is hidden" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource SettingSubtitleStyle}" Text="Applies to the Start menu, not to the start with Windows. If the Open the flyout shortcut is not set, &quot;Do nothing&quot; opens Settings." TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="When you open ConnectFlyout while the icon is hidden"
                            ItemsSource="{x:Bind vm:SettingsViewModel.HiddenTrayLaunchOptions}"
                            SelectedIndex="{x:Bind ViewModel.HiddenTrayLaunchIndex, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Expander>
            <!-- /Tray Icon -->

            <!-- Low Battery -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Low battery notifications" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Sends one notification when the battery is below 20%." />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        AutomationProperties.Name="Low battery notifications"
                        IsOn="{x:Bind ViewModel.LowBatteryNotifications, Mode=TwoWay}"
                        Style="{StaticResource CardToggleSwitchStyle}" />
                </Grid>
            </Border>

            <!-- Flyout Controls: which sections the flyout shows; the switches inside are off by default -->
            <Expander Style="{StaticResource SettingsExpanderStyle}">
                <Expander.Header>
                    <StackPanel Margin="0,16" VerticalAlignment="Center">
                        <TextBlock Text="Flyout controls" />
                        <TextBlock Style="{StaticResource SettingSubtitleStyle}" Text="Select the controls that the flyout shows. A hidden control stays on its Settings page." />
                    </StackPanel>
                </Expander.Header>
                <StackPanel Spacing="16">
                    <views:SettingToggleRow
                        IsOn="{x:Bind ViewModel.HideAmbientControls, Mode=TwoWay}"
                        Subtitle="The Ambient sound slider and Focus on voice. Also in Settings &gt; Noise &amp; scenes."
                        Title="Hide ambient sound controls" />
                    <views:SettingToggleRow
                        IsOn="{x:Bind ViewModel.HideScenes, Mode=TwoWay}"
                        Subtitle="The Focus, Office and Aware tiles below Noise control."
                        Title="Hide scenes" />
                    <views:SettingToggleRow
                        IsOn="{x:Bind ViewModel.HidePlayback, Mode=TwoWay}"
                        Subtitle="The device that has the audio, on headphones that can change device. Not in Settings."
                        Title="Hide playback" />
                    <views:SettingToggleRow
                        IsOn="{x:Bind ViewModel.HideSoundControls, Mode=TwoWay}"
                        Subtitle="The Equalizer and DSEE rows. Also in Settings &gt; Sound."
                        Title="Hide sound controls" />
                </StackPanel>
            </Expander>
            <!-- /Flyout Controls -->

            <!-- Theme -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock VerticalAlignment="Center" Text="App theme" />
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="App theme"
                        ItemsSource="{x:Bind vm:SettingsViewModel.ThemeOptions}"
                        SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Logging: the switch in the header, the log folder inside -->
            <Expander Style="{StaticResource SettingsExpanderStyle}">
                <Expander.Header>
                    <views:SettingToggleRow
                        Margin="0,16"
                        IsOn="{x:Bind ViewModel.DebugLogging, Mode=TwoWay}"
                        Subtitle="Also writes all data sent to and from the headphones to the log. Turn on only to find a fault."
                        Title="Debug logging" />
                </Expander.Header>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Log folder" />
                        <TextBlock
                            Style="{StaticResource SettingSubtitleStyle}"
                            Text="{x:Bind ViewModel.LogFolder}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.OpenLogFolderCommand}"
                        Content="Open log folder" />
                </Grid>
            </Expander>
            <!-- /Logging -->
        </StackPanel>
    </ContentControl>
</local:SettingsPageBase>
