<local:SettingsPageBase
    x:Class="ConnectFlyout.App.Views.Settings.AppPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConnectFlyout.App.Views.Settings"
    xmlns:views="using:ConnectFlyout.App.Views"
    xmlns:vm="using:ConnectFlyout.Presentation.ViewModels">

    <ContentControl Style="{StaticResource SettingsPageStyle}">
        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="General" />

            <!-- Launch At Sign-In -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Start when I sign in" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="If this won't turn on, check Settings &gt; Apps &gt; Startup." />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        AutomationProperties.Name="Start when I sign in"
                        IsOn="{x:Bind ViewModel.LaunchAtSignIn, Mode=TwoWay}"
                        Style="{StaticResource CardToggleSwitchStyle}" />
                </Grid>
            </Border>

            <!-- Tray Icon: the main switch in the header, "until my headphones connect" inside -->
            <Expander Style="{StaticResource SettingsExpanderStyle}">
                <!-- No hover box behind the arrow -->
                <Expander.Resources>
                    <SolidColorBrush x:Key="ExpanderChevronPointerOverBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderChevronPressedBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderChevronBorderPointerOverBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ExpanderChevronBorderPressedBrush" Color="Transparent" />
                </Expander.Resources>
                <Expander.Header>
                    <views:SettingToggleRow
                        Margin="0,16"
                        IsOn="{x:Bind ViewModel.HideTray, Mode=TwoWay}"
                        Subtitle="ConnectFlyout keeps running in the background. Opening it from the Start menu does what you pick below."
                        Title="Hide the tray icon" />
                </Expander.Header>
                <StackPanel Spacing="16">
                    <!-- Hide Until Connected -->
                    <views:SettingToggleRow
                        IsEnabled="{x:Bind ViewModel.CanHideTrayWhileDisconnected, Mode=OneWay}"
                        IsOn="{x:Bind ViewModel.HideTrayWhileDisconnected, Mode=TwoWay}"
                        Subtitle="Shows it again while your headphones are connected."
                        Title="Hide the tray icon until my headphones connect" />

                    <!-- Hidden Tray Launch -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="When I open ConnectFlyout while the icon is hidden" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource SettingSubtitleStyle}" Text="From the Start menu, not when it starts with Windows. If the Open the flyout shortcut isn't set, &quot;Do nothing&quot; opens Settings instead, so you can always get back in." TextWrapping="Wrap" />
                        </StackPanel>
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="When I open ConnectFlyout while the icon is hidden"
                            ItemsSource="{x:Bind vm:SettingsViewModel.HiddenTrayLaunchOptions}"
                            SelectedIndex="{x:Bind ViewModel.HiddenTrayLaunchIndex, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Expander>
            <!-- /Tray Icon -->

            <!-- Low Battery -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Low battery notifications" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Notifies you once when your headphones drop below 20%." />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="1"
                        AutomationProperties.Name="Low battery notifications"
                        IsOn="{x:Bind ViewModel.LowBatteryNotifications, Mode=TwoWay}"
                        Style="{StaticResource CardToggleSwitchStyle}" />
                </Grid>
            </Border>

            <!-- Theme -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock VerticalAlignment="Center" Text="App theme" />
                    <ComboBox
                        Grid.Column="1"
                        MinWidth="180"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="App theme"
                        ItemsSource="{x:Bind vm:SettingsViewModel.ThemeOptions}"
                        SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- Logging -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Debug logging" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Also logs every byte sent to and from the headphones. Turn on only when troubleshooting." />
                        </StackPanel>
                        <ToggleSwitch
                            Grid.Column="1"
                            AutomationProperties.Name="Debug logging"
                            IsOn="{x:Bind ViewModel.DebugLogging, Mode=TwoWay}"
                            Style="{StaticResource CardToggleSwitchStyle}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind ViewModel.LogFolder}"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            Grid.Column="1"
                            Command="{x:Bind ViewModel.OpenLogFolderCommand}"
                            Content="Open log folder" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ContentControl>
</local:SettingsPageBase>
