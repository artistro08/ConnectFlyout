<local:SettingsPageBase
    x:Class="ConnectFlyout.App.Views.Settings.SystemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConnectFlyout.App.Views.Settings"
    xmlns:vm="using:ConnectFlyout.Presentation.ViewModels">

    <ScrollViewer>
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch" Spacing="8">
            <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="System" />
            <local:HeadsetSelector ViewModel="{x:Bind ViewModel}" />

            <!-- Settings (disabled while the headphones are disconnected) -->
            <ContentControl
                IsEnabled="{x:Bind ViewModel.SelectedHeadset.IsConnected, Mode=OneWay, FallbackValue=False}"
                Style="{StaticResource SectionStyle}"
                Visibility="{x:Bind ViewModel.HasHeadset, Mode=OneWay}">
                <StackPanel Spacing="8">

                    <!-- Auto Power-Off -->
                    <Border Style="{StaticResource SettingsCardStyle}" Visibility="{x:Bind ViewModel.SelectedHeadset.Features.AutoPowerOff, Mode=OneWay}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Auto power-off" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Turns the headphones off after they sit unused." />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                MinWidth="180"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Auto power-off"
                                ItemsSource="{x:Bind ViewModel.SelectedHeadset.DisplayedAutoPowerOffOptions, Mode=OneWay}"
                                SelectedIndex="{x:Bind ViewModel.SelectedHeadset.AutoPowerOffIndex, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <!-- Adaptive Volume -->
                    <Border Style="{StaticResource SettingsCardStyle}" Visibility="{x:Bind ViewModel.SelectedHeadset.Features.AdaptiveVolume, Mode=OneWay}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Adaptive volume" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Adjusts the volume to the noise around you." />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                AutomationProperties.Name="Adaptive volume"
                                IsOn="{x:Bind ViewModel.SelectedHeadset.AdaptiveVolume, Mode=TwoWay}"
                                Style="{StaticResource CardToggleSwitchStyle}" />
                        </Grid>
                    </Border>

                    <!-- Voice Guidance -->
                    <Border
                        Style="{StaticResource SettingsCardStyle}"
                        Visibility="{x:Bind ViewModel.SelectedHeadset.HasVoiceGuidanceControl, Mode=OneWay}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Voice guidance" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Plays spoken status and setting updates." />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                AutomationProperties.Name="Voice guidance"
                                IsOn="{x:Bind ViewModel.SelectedHeadset.VoiceGuidance, Mode=TwoWay}"
                                Style="{StaticResource CardToggleSwitchStyle}" />
                        </Grid>
                    </Border>

                    <!-- Bluetooth Connection Quality -->
                    <Border
                        Style="{StaticResource SettingsCardStyle}"
                        Visibility="{x:Bind ViewModel.SelectedHeadset.HasConnectionQualityControl, Mode=OneWay}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Connection mode" />
                                <TextBlock
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="Chooses SBC, AAC, or High Quality for Bluetooth audio." />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                MinWidth="180"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Connection mode"
                                IsEnabled="{x:Bind ViewModel.SelectedHeadset.CanChangeConnectionMode, Mode=OneWay}"
                                ItemsSource="{x:Bind vm:HeadsetViewModel.ConnectionQualityOptions}"
                                SelectedIndex="{x:Bind ViewModel.SelectedHeadset.ConnectionQualityIndex, Mode=TwoWay}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ContentControl>
            <!-- /Settings -->

            <!-- Nothing To Configure -->
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.NoSystemOptions, Mode=OneWay}"
                Message="No options to configure."
                Severity="Informational"
                Visibility="{x:Bind ViewModel.NoSystemOptions, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</local:SettingsPageBase>
