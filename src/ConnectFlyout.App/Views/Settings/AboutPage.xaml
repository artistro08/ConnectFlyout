<local:SettingsPageBase
    x:Class="ConnectFlyout.App.Views.Settings.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConnectFlyout.App.Views.Settings">

    <ScrollViewer>
        <StackPanel MaxWidth="900" HorizontalAlignment="Stretch" Spacing="8">
            <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="About" />

            <!-- App -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="32"
                        Glyph="&#xE7F6;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="ConnectFlyout" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind local:AboutPage.VersionText}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Credits -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="Protocol code based on sony-device-center (MIT)."
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        Grid.Column="1"
                        Content="View on GitHub"
                        NavigateUri="https://github.com/marconvcm/sony-device-center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:SettingsPageBase>
