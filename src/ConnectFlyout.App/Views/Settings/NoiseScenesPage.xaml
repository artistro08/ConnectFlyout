<local:SettingsPageBase
    x:Class="ConnectFlyout.App.Views.Settings.NoiseScenesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConnectFlyout.App.Views.Settings"
    xmlns:views="using:ConnectFlyout.App.Views"
    xmlns:vm="using:ConnectFlyout.Presentation.ViewModels">

    <!-- The page scrolls above a footer that stays put -->
    <Grid RowDefinitions="*,Auto">
        <ContentControl Style="{StaticResource SettingsPageStyle}">
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="Noise &amp; scenes" />
                <TextBlock
                    Margin="0,0,0,8"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="Scenes are the buttons below Noise control in the flyout. Each one applies a noise control setting. Changes are saved as you make them." />

                <!-- Scene Cards: icon, name and a summary in the header; the settings and Delete inside -->
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Scenes}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="8" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:SceneEditorViewModel">
                            <views:SettingsExpander Style="{StaticResource SettingsExpanderStyle}">
                                <views:SettingsExpander.Header>
                                    <Grid
                                        Margin="0,16"
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="16">
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontSize="20"
                                            Glyph="{x:Bind Glyph, Mode=OneWay}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" />
                                            <TextBlock Style="{StaticResource SettingSubtitleStyle}" Text="{x:Bind Summary, Mode=OneWay}" />
                                        </StackPanel>
                                    </Grid>
                                </views:SettingsExpander.Header>
                                <StackPanel>
                                    <local:SceneEditor Scene="{x:Bind}" />

                                    <!-- Delete: only here, inside the open card -->
                                    <Border Style="{StaticResource SettingsExpanderDividerStyle}" />
                                    <Border Style="{StaticResource SettingsExpanderItemStyle}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Delete scene" />
                                                <TextBlock Style="{StaticResource SettingSubtitleStyle}" Text="Removes the scene from the flyout and from this page." />
                                            </StackPanel>
                                            <Button
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Delete scene"
                                                Click="OnDeleteSceneClick"
                                                Content="Delete"
                                                Tag="{x:Bind}" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </views:SettingsExpander>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <!-- /Scene Cards -->
            </StackPanel>
        </ContentControl>

        <!-- Footer -->
        <Border Grid.Row="1" Style="{StaticResource SettingsFooterStyle}">
            <Grid MaxWidth="900">
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button Command="{x:Bind ViewModel.ResetScenesCommand}" Content="Reset to defaults" />
                    <Button
                        Click="OnAddSceneClick"
                        Content="Add scene"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
        <!-- /Footer -->
    </Grid>
</local:SettingsPageBase>
