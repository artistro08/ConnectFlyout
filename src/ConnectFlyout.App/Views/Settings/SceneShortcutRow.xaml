<UserControl
    x:Class="ConnectFlyout.App.Views.Settings.SceneShortcutRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConnectFlyout.App.Views.Settings">

    <!-- Shortcut Row: the picker in an expander row, the warning under it -->
    <StackPanel>
        <Border Style="{StaticResource SettingsExpanderItemStyle}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Shortcut" />
                    <TextBlock Style="{StaticResource SettingSubtitleStyle}" Text="Applies the scene from any Windows app." />
                </StackPanel>
                <local:ShortcutControl
                    x:Name="Picker"
                    Grid.Column="1"
                    VerticalAlignment="Center" />
            </Grid>
        </Border>
        <InfoBar
            x:Name="Warning"
            Margin="16,0,16,8"
            IsClosable="False"
            Severity="Warning"
            Visibility="Collapsed" />
    </StackPanel>
</UserControl>
