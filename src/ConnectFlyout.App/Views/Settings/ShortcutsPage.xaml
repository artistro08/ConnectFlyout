<Page
    x:Class="ConnectFlyout.App.Views.Settings.ShortcutsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ContentControl Style="{StaticResource SettingsPageStyle}">
        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="Shortcuts" />
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource SecondaryTextStyle}"
                Text="Switch noise modes from anywhere in Windows."
                TextWrapping="Wrap" />

            <!-- Shortcut Rows: one card and warning per noise mode, built in code -->
            <StackPanel x:Name="Rows" Spacing="8" />
        </StackPanel>
    </ContentControl>
</Page>
