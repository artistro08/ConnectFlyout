<Page
    x:Class="ConnectFlyout.App.Views.Settings.ShortcutsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ContentControl Style="{StaticResource SettingsPageStyle}">
        <StackPanel Spacing="8">
            <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="Shortcuts" />

            <!-- Main Shortcuts: one card and warning per noise mode and the flyout, built in code -->
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Main shortcuts" />
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource SecondaryTextStyle}"
                Text="Change the noise mode or open the flyout from any Windows app."
                TextWrapping="Wrap" />
            <StackPanel x:Name="Rows" Spacing="8" />

            <!-- Scenes: one row per scene, none set until the user sets one -->
            <TextBlock
                Margin="0,16,0,0"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Scenes" />
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource SecondaryTextStyle}"
                Text="Apply a scene from any Windows app. A scene has no shortcut until you set one. The same picker is also on each scene card in Settings &gt; Scenes."
                TextWrapping="Wrap" />
            <StackPanel x:Name="SceneRows" Spacing="8" />
            <TextBlock
                x:Name="NoScenes"
                Style="{StaticResource SecondaryTextStyle}"
                Text="There are no scenes. Add one in Settings &gt; Scenes."
                Visibility="Collapsed" />
        </StackPanel>
    </ContentControl>
</Page>
