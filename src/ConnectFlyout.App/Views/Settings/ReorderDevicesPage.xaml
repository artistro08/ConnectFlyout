<local:SettingsPageBase
    x:Class="ConnectFlyout.App.Views.Settings.ReorderDevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConnectFlyout.App.Views.Settings"
    xmlns:views="using:ConnectFlyout.App.Views"
    xmlns:vm="using:ConnectFlyout.Presentation.ViewModels">

    <!-- The page scrolls under a footer that stays put; the bottom margin lets the last row
         scroll clear of it -->
    <Grid>
        <ContentControl Style="{StaticResource SettingsPageStyle}">
            <StackPanel Margin="0,0,0,57" Spacing="8">
                <TextBlock Style="{StaticResource SettingsPageTitleStyle}" Text="Reorder headphones" />
                <TextBlock
                    Margin="0,0,0,8"
                    Style="{StaticResource SecondaryTextStyle}"
                    Text="Drag the headphones into the order you want. The flyout and the Devices page use this order." />

                <!-- Drag List: the list's own scrolling is off so the page scrolls as one. The
                     order is saved when a drag ends. -->
                <ListView
                    AllowDrop="True"
                    CanDragItems="True"
                    CanReorderItems="True"
                    DragItemsCompleted="OnDragItemsCompleted"
                    ItemsSource="{x:Bind ViewModel.Headsets}"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:HeadsetViewModel">
                            <Border Style="{StaticResource SettingsCardStyle}">
                                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="16">
                                    <!-- Grip, so the row reads as draggable -->
                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE700;" />
                                    <views:DevicePicture Grid.Column="1" VerticalAlignment="Center" ModelName="{x:Bind ModelName}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind DeviceName, Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ContentControl>

        <!-- Footer -->
        <Border Style="{StaticResource SettingsFooterStyle}">
            <Grid MaxWidth="900">
                <Button
                    HorizontalAlignment="Right"
                    Click="OnDoneClick"
                    Content="Done"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>
        <!-- /Footer -->
    </Grid>
</local:SettingsPageBase>
