<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Theme Brushes -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="FlyoutFooterBackgroundBrush" Color="#0F000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="FlyoutFooterBackgroundBrush" Color="#33000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="FlyoutFooterBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Flyout Section Header -->
    <Style x:Key="FlyoutSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!-- Secondary Text -->
    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Text Link: a link that stands in for a line of secondary text at the same size, so
         swapping the two doesn't move the layout; hover shows the link color -->
    <Style x:Key="TextLinkStyle" TargetType="HyperlinkButton" BasedOn="{StaticResource DefaultHyperlinkButtonStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Setting Row Subtitle: the line under a setting's name -->
    <Style x:Key="SettingSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Caution Text: a short error in place of a status line -->
    <Style x:Key="CautionTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Noise Control Tiles: Quick Settings' tile, a toggle button 48 px tall with the standard
         control corners and just the icon; the label sits underneath (NoiseModeTile). Checked is
         the accent look, and the icon takes the checked foreground with it. -->
    <Style x:Key="TileButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
    </Style>

    <!-- Footer Buttons -->
    <Style x:Key="FooterIconButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Scene Buttons -->
    <Style x:Key="SceneButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="SceneButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- Earbud Side Badges (L / R circles in the flyout header). Drawn with an Ellipse, which is
         anti-aliased; a Border with a round CornerRadius has jagged edges this small. -->
    <Style x:Key="SideBadgeStyle" TargetType="Grid">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SideBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!-- Tight bounds center the letter itself, not the line box with its descender space -->
        <Setter Property="TextLineBounds" Value="Tight" />
    </Style>

    <!-- Charging Case Icon: lid and body with a see-through gap between them -->
    <Style x:Key="CaseIconPartStyle" TargetType="Border">
        <Setter Property="Width" Value="20" />
        <Setter Property="Background" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Slider Thumb: WinUI's vertical thumb ships as an old flat bar; use the round one the
         horizontal slider has -->
    <x:Double x:Key="SliderVerticalThumbWidth">18</x:Double>
    <x:Double x:Key="SliderVerticalThumbHeight">18</x:Double>

    <!-- Equalizer Bands (Settings > Devices): the standard slider, turned vertical, -10 to +10,
         with a notch every 5 steps -->
    <Style x:Key="EqualizerBandSliderStyle" TargetType="Slider" BasedOn="{StaticResource DefaultSliderStyle}">
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Height" Value="180" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Minimum" Value="-10" />
        <Setter Property="Maximum" Value="10" />
        <Setter Property="StepFrequency" Value="1" />
        <Setter Property="TickFrequency" Value="5" />
        <Setter Property="TickPlacement" Value="Outside" />
    </Style>

    <Style x:Key="EqualizerBandLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- Picker Row (flyout headphone list). Its hover and press backgrounds fade through a
         BrushTransition set on the row itself (transitions can't be set from a style). -->
    <Style x:Key="PickerRowStyle" TargetType="Grid">
        <Setter Property="Padding" Value="12" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Section: wraps a group of controls so one IsEnabled disables them all (panels can't) -->
    <Style x:Key="SectionStyle" TargetType="ContentControl">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

    <!-- Card Switch: no On/Off text beside it, so the switch sits flush right like the other
         controls on a card. The template keeps a 12 px column for that text even when empty,
         so the margin takes it back. -->
    <Style x:Key="CardToggleSwitchStyle" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,0,-12,0" />
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
    </Style>

    <!-- Settings Cards -->
    <Style x:Key="SettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="MinHeight" Value="68" />
    </Style>

    <!-- Expander Chevron: Windows Settings' metrics (the Community Toolkit's SettingsExpander):
         a 32 px box 8 px from the edge, 12 px from the header's control to the 16 px glyph, no
         hover box behind the arrow. The glyph size itself is set by SettingsExpander, since
         WinUI reads it through a StaticResource an app can't override. -->
    <Thickness x:Key="ExpanderChevronMargin">4,0,8,0</Thickness>
    <SolidColorBrush x:Key="ExpanderChevronPointerOverBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ExpanderChevronPressedBackground" Color="Transparent" />
    <SolidColorBrush x:Key="ExpanderChevronBorderPointerOverBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ExpanderChevronBorderPressedBrush" Color="Transparent" />

    <!-- Settings Expander: a card whose header holds a setting and whose content holds the
         settings that go with it, one SettingsExpanderItem each with a divider between -->
    <Style x:Key="SettingsExpanderStyle" TargetType="Expander">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Settings Expander Item: a row inside an expander. The right padding ends where the
         header's control does (chevron box plus its margins), so controls line up. -->
    <Style x:Key="SettingsExpanderItemStyle" TargetType="Border">
        <Setter Property="MinHeight" Value="60" />
        <Setter Property="Padding" Value="16,14,44,14" />
    </Style>

    <Style x:Key="SettingsExpanderDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    </Style>

    <!-- Settings Page: scrolls, pads, and centers the content at up to 900 wide. The padded Grid
         fills the width so the centering uses the content's real width; centered straight in the
         ScrollViewer, it's pushed off the right edge on wide windows. The scrollbar stays on the
         window edge. -->
    <Style x:Key="SettingsPageStyle" TargetType="ContentControl">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <ScrollViewer>
                        <Grid Padding="36,24">
                            <ContentPresenter MaxWidth="900" HorizontalAlignment="Stretch" />
                        </Grid>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsPageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
</ResourceDictionary>
