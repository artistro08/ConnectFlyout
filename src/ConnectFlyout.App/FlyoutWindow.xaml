<Window
    x:Class="ConnectFlyout.App.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ConnectFlyout.App"
    Title="ConnectFlyout">

    <!-- Transparent Window, so only the panel shows -->
    <Window.SystemBackdrop>
        <local:TransparentBackdrop />
    </Window.SystemBackdrop>

    <!-- Window Root: the margin around the panel is part of the window, so the window's edge
         at the taskbar is where the sliding panel gets cut off -->
    <Grid x:Name="WindowRoot" Padding="12">

        <!-- Slide Host: moves in and out; the panel inside keeps its own depth for the shadow -->
        <Grid x:Name="SlideHost">

            <!-- Panel -->
            <Grid
                x:Name="Panel"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Translation="0,0,32">
                <Grid.Shadow>
                    <ThemeShadow />
                </Grid.Shadow>

                <!-- Acrylic Background -->
                <SystemBackdropElement CornerRadius="8">
                    <SystemBackdropElement.SystemBackdrop>
                        <local:ActiveAcrylicBackdrop />
                    </SystemBackdropElement.SystemBackdrop>
                </SystemBackdropElement>

                <!-- Flyout View (added in code). The StackPanel lets the view take its natural
                     height, so the panel's own Height can animate towards it. -->
                <StackPanel VerticalAlignment="Top">
                    <ContentPresenter x:Name="ViewHost" />
                </StackPanel>
            </Grid>
            <!-- /Panel -->
        </Grid>
        <!-- /Slide Host -->
    </Grid>
</Window>
