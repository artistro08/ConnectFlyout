<Window
    x:Class="ConnectFlyout.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ConnectFlyout Settings">

    <!-- Mica Background -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*">

        <!-- Title Bar: the menu button sits where the app icon would, next to the title -->
        <TitleBar
            x:Name="AppTitleBar"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="OnPaneToggleRequested"
            Title="ConnectFlyout Settings" />

        <!-- Navigation -->
        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="240"
            PaneDisplayMode="Left"
            ItemInvoked="OnItemInvoked"
            SelectionChanged="OnSelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Devices" Tag="Devices">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Scenes" Tag="Scenes">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Shortcuts" Tag="Shortcuts">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE765;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="General" Tag="General">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="About" Tag="About">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- Quit: an action, not a page; only shown while the tray icon (and its Quit) is hidden -->
                <NavigationViewItem
                    x:Name="QuitItem"
                    Content="Quit"
                    SelectsOnInvoked="False"
                    Tag="Quit">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- Each page pads inside its own scroll area, so the scrollbar sits on the window edge -->
            <Frame x:Name="ContentFrame" />
        </NavigationView>
        <!-- /Navigation -->
    </Grid>
</Window>
