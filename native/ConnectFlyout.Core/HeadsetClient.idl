namespace ConnectFlyout.Core
{
    enum NoiseMode
    {
        Off = 0,
        NoiseCancelling = 1,
        Ambient = 2
    };

    enum ProtocolGeneration
    {
        V1 = 0,
        V2 = 1
    };

    enum NativeLogLevel
    {
        Debug = 0,
        Information = 1,
        Warning = 2,
        Error = 3
    };

    // Battery levels in percent. -1 means the headset didn't report that cell.
    struct BatteryInfo
    {
        Int32 Main;
        Int32 Left;
        Int32 Right;
        Int32 CaseBattery;
        Boolean Charging;
    };

    struct NoiseControlInfo
    {
        NoiseMode Mode;
        Int32 AmbientLevel;
        Boolean FocusOnVoice;
    };

    // Band and Clear Bass values run from -10 to 10.
    struct EqualizerInfo
    {
        Int32 Preset;
        Int32 ClearBass;
        Int32 Band1;
        Int32 Band2;
        Int32 Band3;
        Int32 Band4;
        Int32 Band5;
    };

    struct HeadsetCapabilities
    {
        Boolean DualBattery;
        Boolean NoiseCancelling;
        Boolean AmbientSound;
        Boolean FocusOnVoice;
        Boolean Equalizer;
        Boolean ClearBass;
        Boolean Dsee;
        Boolean SpeakToChat;
        Boolean AdaptiveVolume;
        Boolean AutoPowerOff;
        Boolean FirmwareInfo;
        Boolean CodecInfo;
        Boolean ConnectionQuality;
        Boolean DseeExtreme;
        Boolean VoiceGuidance;
        Boolean Vpt;
        Boolean SoundPosition;
        Boolean PowerOff;
        Boolean AutoPowerOffWhenRemoved;
    };

    struct HeadsetState
    {
        BatteryInfo Battery;
        NoiseControlInfo NoiseControl;
        EqualizerInfo Equalizer;
        Boolean Dsee;
        Boolean SpeakToChat;
        Boolean AdaptiveVolume;
        Int32 AutoPowerOff;
        String Firmware;
        String Codec;
        Int32 ConnectionQuality;
        Int32 VoiceGuidance;
        Int32 Vpt;
        Int32 SoundPosition;
    };

    // A device connected to the headset (multipoint), and whether it has playback.
    struct PlaybackDeviceInfo
    {
        String Address;
        String Name;
        Boolean Playing;
    };

    struct EqualizerPresetInfo
    {
        Int32 Value;
        String Name;
    };

    delegate void NativeLogHandler(NativeLogLevel level, String message);

    // One Sony headset over Bluetooth RFCOMM. Every async call runs on the
    // thread pool and fails with an HRESULT from sony::protocol::toHresult.
    runtimeclass HeadsetClient : Windows.Foundation.IClosable
    {
        HeadsetClient(String deviceName);

        static void SetLogHandler(NativeLogHandler handler);
        static void SetDebugLogging(Boolean enabled);
        static EqualizerPresetInfo[] GetEqualizerPresets();

        // Asks Windows to connect this paired headset's audio (what Connect in Settings > Sound
        // does). True when Windows took the request; the headset still has to be on and near.
        static Windows.Foundation.IAsyncOperation<Boolean> ConnectAudioAsync(String bluetoothAddress);
        static Windows.Foundation.IAsyncOperation<Boolean> DisconnectAudioAsync(String bluetoothAddress);

        String DeviceName { get; };
        String ModelName { get; };
        Boolean IsKnownModel { get; };
        ProtocolGeneration Protocol { get; };
        HeadsetCapabilities Capabilities { get; };
        Boolean IsConnected { get; };
        HeadsetState State { get; };

        // Devices connected to the headset, when it supports switching playback between
        // them; empty otherwise. Read it again after StateChanged.
        PlaybackDeviceInfo[] GetPlaybackDevices();

        Windows.Foundation.IAsyncAction ConnectAsync(String bluetoothAddress);
        void Disconnect();
        Windows.Foundation.IAsyncAction RefreshBatteryAsync();
        Windows.Foundation.IAsyncAction SetNoiseControlAsync(NoiseControlInfo value);
        Windows.Foundation.IAsyncAction SetEqualizerPresetAsync(Int32 preset);
        Windows.Foundation.IAsyncAction SetEqualizerCustomAsync(EqualizerInfo value);
        Windows.Foundation.IAsyncAction SetDseeAsync(Boolean enabled);
        Windows.Foundation.IAsyncAction PowerOffAsync();
        Windows.Foundation.IAsyncAction SetSpeakToChatAsync(Boolean enabled);
        Windows.Foundation.IAsyncAction SetAdaptiveVolumeAsync(Boolean enabled);
        Windows.Foundation.IAsyncAction SetAutoPowerOffAsync(Int32 index);
        Windows.Foundation.IAsyncAction SwitchPlaybackAsync(String address);

        // Legacy Controls
        // Appended To Preserve Existing WinRT Method Order
        Windows.Foundation.IAsyncAction SetConnectionQualityAsync(Boolean prioritizeStableConnection);
        Windows.Foundation.IAsyncAction SetVptAsync(Int32 preset);
        Windows.Foundation.IAsyncAction SetSoundPositionAsync(Int32 position);
        Windows.Foundation.IAsyncAction SetVoiceGuidanceAsync(Int32 value);

        // Raised on a background thread after every confirmed change.
        event Windows.Foundation.TypedEventHandler<HeadsetClient, HeadsetState> StateChanged;

        // Raised on a background thread when the link drops unexpectedly.
        event Windows.Foundation.TypedEventHandler<HeadsetClient, Object> Disconnected;

    }
}
