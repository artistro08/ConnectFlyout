<!--
    Classic MSI installer for ConnectFlyout, for people who'd rather not install the MSIX
    signing certificate. Built by scripts/Build-Release.ps1 from an unpackaged publish of
    ConnectFlyout.App. WiX Toolset: https://wixtoolset.org/docs/intro/
-->
<Project Sdk="WixToolset.Sdk/5.0.2">

  <PropertyGroup>
    <OutputName>ConnectFlyout</OutputName>

    <!-- Passed by Build-Release.ps1 -->
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0.0</ProductVersion>
    <PublishDir Condition="'$(PublishDir)' == ''">..\artifacts\publish\$(Platform)\</PublishDir>
    <LicenseRtf Condition="'$(LicenseRtf)' == ''">..\artifacts\License.rtf</LicenseRtf>

    <DefineConstants>Version=$(ProductVersion);PublishDir=$(PublishDir);LicenseRtf=$(LicenseRtf)</DefineConstants>

    <!-- Dual-purpose (per-user or per-machine) packages trip ICE checks written for
         single-scope installs: per-user files without registry key paths, folders under the
         user profile, and a shortcut whose scope depends on the choice (ICE38, ICE57, ICE64,
         ICE91). ICE03 flags Windows App SDK DLLs that list several languages in their version
         info; that's metadata only. -->
    <SuppressIces>ICE03;ICE38;ICE57;ICE64;ICE91</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
