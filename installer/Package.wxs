<!--
    ConnectFlyout MSI. Installs just for the current user by default (no admin prompt); the
    wizard's "Advanced" step offers installing for everyone instead.
    https://wixtoolset.org/docs/tools/wixext/wixui/#wixui_advanced
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

    <Package
        Name="ConnectFlyout"
        Manufacturer="Devin Green"
        Version="$(var.Version)"
        UpgradeCode="{5C1E9A47-2B8D-4F63-A0E4-7D3B9C6F1E82}"
        Scope="perUserOrMachine">

        <!-- Upgrades: Windows Installer ignores the 4th version field, so 1.1.0.1 counts as
             the same version as 1.1.0.0 and has to be allowed to replace it -->
        <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of ConnectFlyout is already installed." />
        <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

        <!-- Apps & Features Entry -->
        <Icon Id="AppIcon.ico" SourceFile="$(var.PublishDir)Assets\AppIcon.ico" />
        <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
        <Property Id="ARPURLINFOABOUT" Value="https://github.com/artistro08/ConnectFlyout" />

        <!-- Wizard: per-user by default, per-machine on request -->
        <Property Id="ApplicationFolderName" Value="ConnectFlyout" />
        <Property Id="WixAppFolder" Value="WixPerUserFolder" />
        <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
        <ui:WixUI Id="WixUI_Advanced" />

        <!-- Install Folder. WixUI_Advanced doesn't move it for a per-machine choice when the
             package scope is perUserOrMachine, so these set it from the choice, for both the
             wizard and silent installs:
             https://github.com/orgs/wixtoolset/discussions/7624 -->
        <StandardDirectory Id="ProgramFiles6432Folder">
            <Directory Id="APPLICATIONFOLDER" Name="ConnectFlyout" />
        </StandardDirectory>
        <SetProperty Id="APPLICATIONFOLDER" Action="SetPerMachineFolder" Value="[ProgramFiles6432Folder]ConnectFlyout\" Before="CostFinalize" Sequence="both" Condition="WixAppFolder = &quot;WixPerMachineFolder&quot; AND NOT Installed" />
        <SetProperty Id="APPLICATIONFOLDER" Action="SetPerUserFolder" Value="[LocalAppDataFolder]Programs\ConnectFlyout\" Before="CostFinalize" Sequence="both" Condition="WixAppFolder = &quot;WixPerUserFolder&quot; AND NOT Installed" />
        <!-- Start Menu Shortcut: its app ID is what lets Windows show the app's notifications -->
        <StandardDirectory Id="ProgramMenuFolder">
            <Component Id="StartMenuShortcut">
                <Shortcut
                    Id="AppShortcut"
                    Name="ConnectFlyout"
                    Target="[APPLICATIONFOLDER]ConnectFlyout.exe"
                    WorkingDirectory="APPLICATIONFOLDER"
                    Icon="AppIcon.ico">
                    <ShortcutProperty Key="System.AppUserModel.ID" Value="Artistro08.ConnectFlyout.Classic" />
                </Shortcut>
                <RegistryValue Root="HKMU" Key="Software\ConnectFlyout" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
            </Component>
        </StandardDirectory>

        <!-- Everything -->
        <Feature Id="Main">
            <Files Include="$(var.PublishDir)**" Directory="APPLICATIONFOLDER" />
            <ComponentRef Id="StartMenuShortcut" />
        </Feature>
    </Package>
</Wix>
